#!/bin/bash
# Pre/post hook for markdown formatting
# This hook runs after any Write/Edit operation on .md files
# Place this script in ~/.claude/hooks/ or use the one in this repository

# Read JSON input from stdin
INPUT=$(cat)

# Extract file path using jq for reliable JSON parsing
FILE_PATH=$(echo "$INPUT" | jq -r '.filePath // .path // empty' 2>/dev/null | grep -E '\.md$' | head -1)

# Only process if we found a .md file
if [ -n "$FILE_PATH" ] && [[ "$FILE_PATH" == *.md ]]; then
    echo "Formatting markdown: $FILE_PATH" >&2

    # Use the skill's script to apply both Prettier formatting and markdownlint fixes
    # The script will check for .md-format-ignore file automatically
    python scripts/format_and_lint.py --fix "$FILE_PATH" 2>/dev/null || true
fi

exit 0
